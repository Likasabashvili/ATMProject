<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>ATMProject</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ATMProject.Application\ATMProject.Application.csproj" />
      <ProjectReference Include="..\ATMProject.Domain\ATMProject.Domain.csproj" />
      <ProjectReference Include="..\ATMProject.Infrastructure\ATMProject.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
      <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="appsettings.json" />
      <Content Include="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
